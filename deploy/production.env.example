# Settings contain NO passwords. Keep secret files outside the repository.
SUPORTAI_DOMAIN=suportai.example.org
SUPORTAI_TLS_CONTACT=ti@example.org
APP_ORIGIN=https://suportai.example.org
PDF_SOCKET_DIR=/srv/suportai/pdf-socket
SUPORTAI_DB_PASSWORD_FILE=/srv/suportai/secrets/db_password
SUPORTAI_DATABASE_URL_FILE=/srv/suportai/secrets/database_url
SUPORTAI_AI_KEY_FILE=/srv/suportai/secrets/ai_key
SUPORTAI_IMAGE_TAG=pilot
ALLOW_EXTERNAL_AI_DATA_PROCESSING=false
