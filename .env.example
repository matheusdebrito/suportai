# Configuração local (Docker Compose lê .env automaticamente).
# Preencha com a senha do banco; preserve a senha se já existir um volume.
POSTGRES_PASSWORD=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
SUPORTAI_WEB_PORT=5173
SUPORTAI_LOCAL_ORIGIN=http://localhost:5173
SUPORTAI_DB_PORT=5432

# IA externa: habilite somente após autorização de tratamento dos dados.
OPENAI_API_KEY=
ALLOW_EXTERNAL_AI_DATA_PROCESSING=false
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# Apenas para rodar Node.js diretamente no host, sem os contêineres da aplicação.
# Ajuste a senha (URL-encoded, se necessário) e a porta para corresponder ao banco.
DATABASE_URL=postgres://suportai:change-me@localhost:5432/suportai
APP_ORIGIN=http://localhost:5173
API_PORT=4000
NODE_ENV=development

# Opcional: chave AES-256 do cofre operacional (64 caracteres hexadecimais).
# Gere uma vez, guarde em local seguro e preserve para recuperar backups.
OPERATIONAL_CREDENTIAL_KEY=
